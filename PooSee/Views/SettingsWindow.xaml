<Window x:Class="PooSee.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PooSee — Settings"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <TextBlock Text="Settings" Style="{StaticResource H1Text}" Margin="0,0,0,20"/>

                <!-- Browser -->
                <TextBlock Text="BROWSER" Style="{StaticResource LabelText}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Automatic browser selection"
                                  IsChecked="{Binding Model.AutoSelectBrowser, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Detected browsers" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding DetectedBrowsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,2,0,2">
                                        <Run Text="●"/>
                                        <Run Text="{Binding Name}"/>
                                        <Run Text="—"/>
                                        <Run Text="{Binding Version}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding ExecutablePath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Profile location -->
                <TextBlock Text="PROFILE LOCATION" Style="{StaticResource LabelText}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Base folder for temporary browser profiles." Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                     Text="{Binding Model.ProfileLocation, Mode=TwoWay}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Content="Browse…" Margin="8,0,0,0"
                                    Command="{Binding BrowseProfileCommand}"/>
                        </Grid>

                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Cleanup temporary profiles after each run"
                                  IsChecked="{Binding Model.CleanupProfilesAfterRun, Mode=TwoWay}"
                                  Margin="0,12,0,0"/>

                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Use persistent profiles (do not delete)"
                                  IsChecked="{Binding Model.PersistentProfiles, Mode=TwoWay}"
                                  Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Default sessions -->
                <TextBlock Text="DEFAULT SESSIONS" Style="{StaticResource LabelText}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Automatically recommend session count"
                                  IsChecked="{Binding Model.AutoRecommendSessions, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Manual default" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="80"
                                     Text="{Binding Model.ManualDefaultSessionCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Maximum sessions" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="80"
                                     Text="{Binding Model.MaximumSessionCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Startup -->
                <TextBlock Text="STARTUP BEHAVIOR" Style="{StaticResource LabelText}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Start minimized"
                                  IsChecked="{Binding Model.StartMinimized, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Start in system tray"
                                  IsChecked="{Binding Model.StartInTray, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Restore previous configuration on launch"
                                  IsChecked="{Binding Model.RestorePreviousConfiguration, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Restore previous window state"
                                  IsChecked="{Binding Model.RestorePreviousWindowState, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Minimize to system tray on close"
                                  IsChecked="{Binding Model.MinimizeToTray, Mode=TwoWay}" Margin="0,0,0,6"/>
                        <CheckBox Style="{StaticResource AppCheckBox}"
                                  Content="Always on top"
                                  IsChecked="{Binding Model.AlwaysOnTop, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource LabelText}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding Model.Theme, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="System" Tag="System"/>
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource PanelBackgroundBrush}"
                Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>