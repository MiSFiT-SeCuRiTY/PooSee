<Window x:Class="PooSee.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PooSee"
        Width="420" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="PooSee" Style="{StaticResource H1Text}" FontSize="22"/>
            <TextBlock Text="Browser Session Testing Utility"
                       Style="{StaticResource MutedText}" Margin="0,4,0,20"/>

            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
                <Run Text="Version: " FontWeight="SemiBold"/>
                <Run Text="1.0.0"/>
            </TextBlock>

            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
                <Run Text="Developed by: " FontWeight="SemiBold"/>
                <Run Text="MiSFiT-SeCuRiTY"/>
            </TextBlock>

            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,20">
                <Run Text="GitHub: " FontWeight="SemiBold"/>
                <Hyperlink NavigateUri="https://github.com/MiSFiT-SeCuRiTY"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="https://github.com/MiSFiT-SeCuRiTY"/>
                </Hyperlink>
            </TextBlock>

            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,20">
                Uses Microsoft Playwright for browser automation. Not affiliated with
                Google, Microsoft, Chrome, Edge, or Playwright.
            </TextBlock>

            <Button Content="Close"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>