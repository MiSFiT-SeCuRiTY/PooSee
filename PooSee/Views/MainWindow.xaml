<Window x:Class="PooSee.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PooSee"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="720" Height="780"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Height="40"
                  Background="{StaticResource PanelBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PooSee" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="· Browser Session Testing Utility"
                               FontSize="12" Margin="8,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="AlwaysOnTopToggle"
                              Style="{StaticResource AppCheckBox}"
                              Content="On top"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Click="AlwaysOnTop_Click"/>

                    <Button Width="46" Height="40"
                            Style="{StaticResource SecondaryButton}"
                            BorderThickness="0"
                            Click="Minimize_Click"
                            ToolTip="Minimize"
                            FontSize="16"
                            Content="—"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Button Width="46" Height="40"
                            Style="{StaticResource SecondaryButton}"
                            BorderThickness="0"
                            Click="Maximize_Click"
                            ToolTip="Maximize / Restore"
                            FontSize="14"
                            Content="▢"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Button Width="46" Height="40"
                            Style="{StaticResource SecondaryButton}"
                            BorderThickness="0"
                            Click="Close_Click"
                            ToolTip="Close"
                            FontSize="14"
                            Content="✕"
                            Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- ===== Header: browser + session count ===== -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrors, Mode=OneWay}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Browser:" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BrowserName, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Margin="6,0,0,0" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BrowserStatus, Mode=OneWay}"
                                   Style="{StaticResource MutedText}"
                                   Margin="16,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sessions:" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Style="{StaticResource InputBox}" Width="60"
                                 Text="{Binding SessionCount, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center"
                                 IsEnabled="{Binding IsIdle, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center">
                            <Run Text="Rec: "/>
                            <Run Text="{Binding RecommendedSessionCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Main content ===== -->
            <Grid Grid.Row="2" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- URL jobs -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="URL JOBS"
                                   Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="0"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddUrlCommand}"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+ " FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Add URL" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Jobs}"
                                              ItemTemplate="{StaticResource UrlJobRowTemplate}"/>

                                <TextBlock HorizontalAlignment="Center" Margin="0,20"
                                           Text="No URL jobs yet — click &quot;Add URL&quot; to get started.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Jobs.Count, Mode=OneWay}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Sessions -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SESSIONS"
                               Style="{StaticResource LabelText}"
                               VerticalAlignment="Center" Margin="0,0,0,6"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Sessions}"
                                              ItemTemplate="{StaticResource SessionRowTemplate}"/>

                                <TextBlock HorizontalAlignment="Center" Margin="0,20"
                                           Text="Idle — press START to launch sessions.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sessions.Count, Mode=OneWay}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText, Mode=OneWay}"
                               Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenPresetsCommand}"
                                Content="Presets" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenSettingsCommand}"
                                Content="Settings" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenAboutCommand}"
                                Content="About" Margin="0,0,14,0"/>

                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartCommand}"
                                Content="START" Padding="20,8"
                                Margin="0,0,6,0" FontWeight="Bold"/>

                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding StopCommand}"
                                Content="STOP ALL" Padding="20,8"
                                FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>