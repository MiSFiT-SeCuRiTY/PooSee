<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Each icon is a simple Path geometry string, 24x24 viewport, stroked. -->

    <Geometry x:Key="IconPlus">M 12,5 L 12,19 M 5,12 L 19,12</Geometry>
    <Geometry x:Key="IconMinus">M 5,12 L 19,12</Geometry>
    <Geometry x:Key="IconEdit">M 4,20 L 4,16 L 16,4 L 20,8 L 8,20 Z</Geometry>
    <Geometry x:Key="IconTrash">M 4,7 L 20,7 M 9,7 L 9,4 L 15,4 L 15,7 M 6,7 L 7,20 L 17,20 L 18,7</Geometry>
    <Geometry x:Key="IconPlay">M 6,4 L 20,12 L 6,20 Z</Geometry>
    <Geometry x:Key="IconStop">M 6,6 L 18,6 L 18,18 L 6,18 Z</Geometry>
    <Geometry x:Key="IconSettings">M 12,8 A 4,4 0 1,1 11.99,8 M 12,2 L 12,5 M 12,19 L 12,22 M 2,12 L 5,12 M 19,12 L 22,12 M 5,5 L 7,7 M 17,17 L 19,19 M 19,5 L 17,7 M 7,17 L 5,19</Geometry>
    <Geometry x:Key="IconSave">M 4,4 L 18,4 L 20,6 L 20,20 L 4,20 Z M 8,4 L 8,10 L 16,10 L 16,4 M 6,14 L 18,14 L 18,20 L 6,20 Z</Geometry>
    <Geometry x:Key="IconClose">M 6,6 L 18,18 M 18,6 L 6,18</Geometry>
    <Geometry x:Key="IconMinimize">M 6,12 L 18,12</Geometry>
    <Geometry x:Key="IconMaximize">M 5,5 L 19,5 L 19,19 L 5,19 Z</Geometry>
    <Geometry x:Key="IconRestore">M 5,8 L 16,8 L 16,19 L 5,19 Z M 9,8 L 9,5 L 19,5 L 19,15 L 16,15</Geometry>
    <Geometry x:Key="IconChevronDown">M 6,10 L 12,16 L 18,10</Geometry>
    <Geometry x:Key="IconChevronUp">M 6,14 L 12,8 L 18,14</Geometry>
    <Geometry x:Key="IconRefresh">M 20,12 A 8,8 0 1,1 18,6 L 22,6 M 22,6 L 22,2</Geometry>

    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stretch" Value="None"/>
    </Style>

</ResourceDictionary>